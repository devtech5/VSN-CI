# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=vsn_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=vsn_ci_db
DATABASE_URL="postgresql://vsn_user:your_password_here@postgres:5432/vsn_ci_db"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── NestJS Backend ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=generate_a_strong_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate_another_strong_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP ──────────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=5
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=VSN-CI

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXTAUTH_SECRET=generate_a_secret_here
NEXTAUTH_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
